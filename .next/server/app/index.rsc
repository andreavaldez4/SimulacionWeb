38:[["$","title","0",{"children":"MultiagentesReto — Cosecha autónoma simulada en Unity 6"}],["$","meta","1",{"name":"description","content":"Simulación multiagente de una granja de trigo autónoma: una cosechadora líder y un tractor seguidor recorriendo un campo procedural. Proyecto universitario presentado a John Deere como socio formador."}]]
